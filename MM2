local StatsService = game:GetService("Stats")

local FPS = 0
local FrameCounter = 0
local FPSStart = tick()

RunService.RenderStepped:Connect(function()

    FrameCounter += 1

    local Now = tick()

    if Now - FPSStart >= 1 then

        FPS = FrameCounter
        FrameCounter = 0
        FPSStart = Now

    end

end)

local function GetPing()

    local Ping = 0

    pcall(function()

        Ping = math.floor(
            StatsService
                .Network
                .ServerStatsItem["Data Ping"]
                :GetValue()
        )

    end)

    return Ping

end

