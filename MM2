local ParticleAlive = true

local function CreateFireParticle()

    if not ParticleAlive then
        return
    end

    if not ProfileGui.Parent then
        return
    end

    local Particle =
        Instance.new("Frame")

    local Size =
        math.random(
            2,
            6
        )

    Particle.Size =
        UDim2.fromOffset(
            Size,
            Size
        )

    Particle.Position =
        UDim2.new(
            math.random(
                5,
                95
            ) / 100,
            0,
            1,
            math.random(
                -5,
                5
            )
        )

    Particle.BackgroundColor3 =
        Color3.fromRGB(
            math.random(
                100,
                180
            ),
            math.random(
                100,
                180
            ),
            math.random(
                100,
                180
            )
        )

    Particle.BackgroundTransparency =
        math.random(
            0,
            25
        ) / 100

    Particle.BorderSizePixel = 0

    Particle.ZIndex = 3

    Particle.Parent =
        ProfileGui

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(
            1,
            0
        )

    Corner.Parent =
        Particle

    local RiseTime =
        math.random(
            10,
            20
        ) / 10

    local EndX =
        math.clamp(
            Particle.Position.X.Scale
            + math.random(
                -12,
                12
            ) / 100,

            0.02,
            0.98
        )

    local Tween =
        game:GetService(
            "TweenService"
        ):Create(

            Particle,

            TweenInfo.new(
                RiseTime,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),

            {

                Position =
                    UDim2.new(
                        EndX,
                        0,
                        0.05,
                        0
                    ),

                Size =
                    UDim2.fromOffset(
                        math.random(
                            1,
                            3
                        ),
                        math.random(
                            1,
                            3
                        )
                    ),

                BackgroundTransparency = 1

            }

        )

    Tween:Play()

    Tween.Completed:Connect(function()

        if Particle then
            Particle:Destroy()
        end

    end)

end

