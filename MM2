local KnockbackEnabled = false
local KnockbackCooldown = false

local KnockbackConnection = nil

local function StartKnockback()

    if KnockbackConnection then
        KnockbackConnection:Disconnect()
        KnockbackConnection = nil
    end

    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    KnockbackConnection = Root.Touched:Connect(function(Hit)

        if not KnockbackEnabled then
            return
        end

        if KnockbackCooldown then
            return
        end

        if not Hit or not Hit:IsA("BasePart") then
            return
        end

        -- ไม่เอาส่วนของตัวเอง
        if Hit:IsDescendantOf(Character) then
            return
        end

        KnockbackCooldown = true

        -- ทิศทางจากสิ่งที่ชน
        local Direction = Root.Position - Hit.Position

        if Direction.Magnitude < 0.1 then
            Direction = Vector3.new(
                math.random(-1, 1),
                0,
                math.random(-1, 1)
            )
        end

        Direction = Direction.Unit

        -- ดีดออก + ขึ้น
        Root.AssemblyLinearVelocity =
            Direction * 90
            + Vector3.new(0, 70, 0)

        -- หมุนด้วย
        local Spin = Instance.new("BodyAngularVelocity")

        Spin.MaxTorque =
            Vector3.new(
                999999,
                999999,
                999999
            )

        Spin.AngularVelocity =
            Vector3.new(
                60,
                60,
                60
            )

        Spin.Parent = Root

        task.delay(1.2, function()
            if Spin and Spin.Parent then
                Spin:Destroy()
            end
        end)

        task.delay(0.15, function()
            KnockbackCooldown = false
        end)

    end)
end


