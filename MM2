-- =========================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetRoot()

    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()

    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Humanoid")
end


-- =========================================================
-- NOCLIP
-- =========================================================

local function SetFarmNoclip(Value)

    local Character = GetCharacter()

    if not Character then
        return
    end

    for _, Object in ipairs(Character:GetDescendants()) do

        if Object:IsA("BasePart") then
            Object.CanCollide = not Value
        end

    end

end


-- =========================================================
-- FIND NEAREST COIN
-- =========================================================

local function GetNearestCoin(Root)

    local Nearest = nil
    local NearestDistance = math.huge

    for _, Object in ipairs(workspace:GetDescendants()) do

        if Object.Name == "Coin_Server"
        and Object:IsA("BasePart")
        and Object:FindFirstChild("TouchInterest")
        and Object:FindFirstChild("CoinVisual")
        and not CollectedCoins[Object]
        and not Object:GetAttribute("Collected") then

            local Distance =
                (Root.Position - Object.Position).Magnitude

            if Distance < NearestDistance then

                NearestDistance = Distance
                Nearest = Object

            end

        end

    end

    return Nearest

end


-- =========================================================
-- FLY TO COIN
-- =========================================================

local function FlyToCoin(Coin)

    local Root = GetRoot()
    local Humanoid = GetHumanoid()

    if not Root or not Humanoid then
        return
    end

    Humanoid.PlatformStand = true

    local StartTime = tick()

    while CoinFarmEnabled
    and Coin
    and Coin.Parent
    and Root.Parent do

        if tick() - StartTime > 10 then
            break
        end

        if Coin:GetAttribute("Collected") then
            break
        end

        local TargetPosition = Coin.Position

        if FlyMode == "นอนคว่ำ" then

            TargetPosition =
                TargetPosition - Vector3.new(0, 2.5, 0)

        end

        local Difference =
            TargetPosition - Root.Position

        local Distance = Difference.Magnitude

        if Distance <= 2 then
            break
        end

        local Direction = Difference.Unit

        Root.AssemblyLinearVelocity =
            Direction * FlySpeed

        if FlyMode == "นอนคว่ำ" then

            Root.CFrame =
                CFrame.new(
                    Root.Position,
                    Coin.Position
                )
                * CFrame.Angles(
                    math.rad(90),
                    0,
                    0
                )

        else

            Root.CFrame =
                CFrame.new(
                    Root.Position,
                    Coin.Position
                )

        end

        SetFarmNoclip(true)

        RunService.Heartbeat:Wait()

    end

    if Coin then
        CollectedCoins[Coin] = true
    end

    StartedCollecting = true

    if Root and Root.Parent then
        Root.AssemblyLinearVelocity = Vector3.zero
    end

end


-- =========================================================
-- RESET CHARACTER
-- =========================================================

local function ResetCharacter()

    local Character = GetCharacter()

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid.Health = 0
    end

end


-- =========================================================
-- STOP FARM
-- =========================================================

local function StopCoinFarm()

    CoinFarmEnabled = false

    local Humanoid = GetHumanoid()
    local Root = GetRoot()

    if Humanoid then
        Humanoid.PlatformStand = false
    end

    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end

    SetFarmNoclip(false)

end


-- =========================================================
-- COIN FARM LOOP
-- =========================================================

local function StartCoinFarm()

    if CoinFarmRunning then
        return
    end

    CoinFarmRunning = true

    task.spawn(function()

        while CoinFarmEnabled do

            local Success = pcall(function()

                local Root = GetRoot()

                if not Root then
                    task.wait(1)
                    return
                end

                SetFarmNoclip(true)

                local Coin =
                    GetNearestCoin(Root)

                if Coin then

                    FlyToCoin(Coin)

                else

                    if AutoReset
                    and StartedCollecting then

                        CollectedCoins = {}
                        StartedCollecting = false

                        ResetCharacter()

                        task.wait(2)

                    else

                        task.wait(0.2)

                    end

                end

            end)

            if not Success then
                task.wait(0.5)
            end

        end

        CoinFarmRunning = false

    end)

end


