local UndergroundNoclipConnection = nil
local UndergroundVelocity = nil
local UndergroundCameraConnection = nil

local Camera = workspace.CurrentCamera


--==============================================================
-- คืน Collision ตัวละคร
--==============================================================

local function RestoreCharacterCollision()

    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    for _, Part in ipairs(Character:GetDescendants()) do

        if Part:IsA("BasePart") then
            Part.CanCollide = true
        end

    end
end


--==============================================================
-- หยุดระบบมุดดิน
--==============================================================

local function StopUnderground()

    if UndergroundNoclipConnection then
        UndergroundNoclipConnection:Disconnect()
        UndergroundNoclipConnection = nil
    end

    if UndergroundCameraConnection then
        UndergroundCameraConnection:Disconnect()
        UndergroundCameraConnection = nil
    end

    if UndergroundVelocity then
        UndergroundVelocity:Destroy()
        UndergroundVelocity = nil
    end

end


