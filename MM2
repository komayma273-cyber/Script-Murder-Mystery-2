--==================================================
-- GET NIL INSTANCE
--==================================================

local function getNil(name, className)
    if not getnilinstances then
        return nil
    end

    for _, v in ipairs(getnilinstances()) do
        if v.ClassName == className and v.Name == name then
            return v
        end
    end

    return nil
end

--==================================================
-- SETTINGS
--==================================================

local BulletDistance = 3
local ShowBulletDistance = false

local BulletPreviewPart = nil
local BulletPreviewConnection = nil

--==================================================
-- FIND MURDERER
--==================================================

local function FindMurderer()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then

            local Character = Player.Character
            local Backpack = Player:FindFirstChild("Backpack")

            if Character and Character:FindFirstChild("Knife") then
                return Player
            end

            if Backpack and Backpack:FindFirstChild("Knife") then
                return Player
            end
        end
    end

    return nil
end

--==================================================
-- GET TARGET PART
--==================================================

local function GetMurdererTarget()
    local Murderer = FindMurderer()

    if not Murderer then
        return nil
    end

    local Character = Murderer.Character

    if not Character then
        return nil
    end

    local Head = Character:FindFirstChild("Head")

    if Head then
        return Head
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- CREATE BULLET PREVIEW
--==================================================

local function CreateBulletPreview()
    if BulletPreviewPart then
        BulletPreviewPart:Destroy()
        BulletPreviewPart = nil
    end

    local Part = Instance.new("Part")

    Part.Name = "KOMAT_BulletDistancePreview"
    Part.Anchored = true
    Part.CanCollide = false
    Part.CanTouch = false
    Part.CanQuery = false

    Part.Material = Enum.Material.Neon
    Part.Color = Color3.fromRGB(80, 190, 255)

    Part.Transparency = 0.25

    Part.Size = Vector3.new(0.18, 0.18, 1)

    Part.Parent = workspace

    BulletPreviewPart = Part
end

--==================================================
-- UPDATE BULLET PREVIEW
--==================================================

local function UpdateBulletPreview()
    if not ShowBulletDistance then
        return
    end

    if not BulletPreviewPart then
        CreateBulletPreview()
    end

    local TargetPart = GetMurdererTarget()

    if not TargetPart then
        BulletPreviewPart.Transparency = 1
        return
    end

    local TargetPosition = TargetPart.Position

    local SpawnPosition =
        TargetPosition
        + (TargetPart.CFrame.LookVector * BulletDistance)

    local Direction = TargetPosition - SpawnPosition
    local Distance = Direction.Magnitude

    if Distance <= 0.05 then
        BulletPreviewPart.Transparency = 1
        return
    end

    BulletPreviewPart.Transparency = 0.25

    BulletPreviewPart.Size = Vector3.new(
        0.18,
        0.18,
        Distance
    )

    BulletPreviewPart.CFrame =
        CFrame.lookAt(
            (SpawnPosition + TargetPosition) / 2,
            TargetPosition
        )
end

--==================================================
-- PREVIEW LOOP
--==================================================

local function StartBulletPreview()
    if BulletPreviewConnection then
        BulletPreviewConnection:Disconnect()
        BulletPreviewConnection = nil
    end

    CreateBulletPreview()

    BulletPreviewConnection = RunService.RenderStepped:Connect(function()
        if not ShowBulletDistance then
            return
        end

        UpdateBulletPreview()
    end)
end

--==================================================
-- STOP PREVIEW
--==================================================

local function StopBulletPreview()
    if BulletPreviewConnection then
        BulletPreviewConnection:Disconnect()
        BulletPreviewConnection = nil
    end

    if BulletPreviewPart then
        BulletPreviewPart:Destroy()
        BulletPreviewPart = nil
    end
end

