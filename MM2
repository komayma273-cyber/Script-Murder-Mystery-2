--==============================================================
-- ระบบกระเด็น
--==============================================================

local FlingRunning = {}

local function FlingPlayer(Target)

    if not Target
    or Target == LocalPlayer
    or not Target.Parent then

        return
    end

    if FlingRunning[Target] then
        return
    end

    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    local TargetCharacter =
        Target.Character

    if not TargetCharacter then
        return
    end

    local TargetRoot =
        TargetCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not TargetRoot then
        return
    end

    FlingRunning[Target] = true

    --==========================================================
    -- บันทึกตำแหน่งเดิม
    --==========================================================

    local OldCFrame =
        Root.CFrame

    local OldPosition =
        Root.Position

    local ForceConnection = nil
    local Running = true

    --==========================================================
    -- เพิ่มแรง
    --==========================================================

    ForceConnection =
        RunService.Heartbeat:Connect(function()

            if not Running then
                return
            end

            if not Root
            or not Root.Parent then

                return
            end

            local Velocity =
                Root.AssemblyLinearVelocity

            Root.AssemblyLinearVelocity =
                Velocity * 8000
                + Vector3.new(
                    0,
                    8000,
                    0
                )

        end)

    --==========================================================
    -- เข้าหาเป้าหมาย
    --==========================================================

    local StartTime = tick()

    while tick() - StartTime < 1.5 do

        if not Running then
            break
        end

        if not Root.Parent
        or not TargetRoot.Parent then

            break
        end

        Root.CFrame =
            TargetRoot.CFrame

        local Direction =
            TargetRoot.Position
            - Root.Position

        if Direction.Magnitude > 0 then

            Root.AssemblyLinearVelocity =
                Direction.Unit * 150

        end

        RunService.Heartbeat:Wait()

    end

    --==========================================================
    -- หยุดแรง
    --==========================================================

    Running = false

    if ForceConnection then

        ForceConnection:Disconnect()
        ForceConnection = nil

    end

    --==========================================================
    -- ดึงตัวเองกลับ
    --==========================================================

    if Root
    and Root.Parent then

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

        Root.CFrame =
            OldCFrame

        task.wait()

        local Distance =
            (
                Root.Position
                - OldPosition
            ).Magnitude

        if Distance > 10 then

            Root.CFrame =
                OldCFrame

        end

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

        task.wait()

        local FinalDistance =
            (
                Root.Position
                - OldPosition
            ).Magnitude

        if FinalDistance > 10 then

            Root.CFrame =
                OldCFrame

            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero

        end

    end

    FlingRunning[Target] = nil

end


