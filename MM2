                                    Billboard


                                TrapESPObjects[Target] = {

                                    Highlight = Highlight,
                                    Billboard = Billboard

                                }

                            end

                        end

                    end

                end


                --==================================================
                -- ลบ ESP ของกับดักที่หายไป
                --==================================================

                for Object, Data in pairs(
                    TrapESPObjects
                ) do

                    if not CurrentTraps[Object]
                    or not Object.Parent then

                        if Data.Highlight then
                            Data.Highlight:Destroy()
                        end

                        if Data.Billboard then
                            Data.Billboard:Destroy()
                        end

                        TrapESPObjects[Object] = nil

                    end

                end


                --==================================================
                -- รอสแกนรอบต่อไป
                --==================================================

                task.wait(0.5)

            end

        end)

    end

})

