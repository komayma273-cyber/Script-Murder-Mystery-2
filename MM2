            -- ถือปืนอยู่ -> ยิงทันที
            if Character and Character:FindFirstChild("Gun") then
                ShootMurderer()
                task.wait(0.3) -- หน่วงเวลาเล็กน้อยเพื่อไม่ให้ส่งรีโมทถี่เกินไป
