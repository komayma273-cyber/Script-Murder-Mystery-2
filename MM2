end

-- ฟังก์ชันวาร์ปไปเก็บปืนแล้ววาร์ปกลับที่เดิม
local function TeleportToGunDrop()
    if IsTeleportingGun then return end

    local Character = LocalPlayer.Character
    if not Character then return end

    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    if not HumanoidRootPart then return end

    local GunDrop = FindGunDrop()
    if not GunDrop then
        if Window and Window.Notify then
            Window:Notify({
                Title = "นายอำเภอ",
                Content = "ไม่พบปืนบนพื้น (No GunDrop)",
                Duration = 3
            })
        end
        return
    end

    IsTeleportingGun = true

    -- บันทึกตำแหน่งเดิมก่อนวาร์ป
    local OriginalCFrame = HumanoidRootPart.CFrame

    -- วาร์ปไปที่ตำแหน่งปืน
    HumanoidRootPart.CFrame = GunDrop.CFrame

    -- หน่วงเวลาเล็กน้อยเพื่อให้ตัวละครสัมผัสและเก็บปืน
    task.wait(0.15)

    -- วาร์ปกลับมาตำแหน่งเดิม
    if HumanoidRootPart then
        HumanoidRootPart.CFrame = OriginalCFrame
    end

    if Window and Window.Notify then
        Window:Notify({
            Title = "นายอำเภอ",
            Content = "วาร์ปไปเก็บปืนเรียบร้อย!",
            Duration = 3
        })
    end

    IsTeleportingGun = false
end

