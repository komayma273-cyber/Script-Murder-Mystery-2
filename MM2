local function getNil(Name, ClassName)
    if not getnilinstances then
        return nil
    end

    for _, Object in ipairs(getnilinstances()) do
        if Object.ClassName == ClassName
        and Object.Name == Name then
            return Object
        end
    end

    return nil
end

local function FindMurderer()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then

            local Character = Player.Character
            local Backpack = Player:FindFirstChild("Backpack")

            if Character and Character:FindFirstChild("Knife") then
                return Player
            end

            if Backpack and Backpack:FindFirstChild("Knife") then
                return Player
            end
        end
    end

    return nil
end

local function RemoveShootMarker()
    if ShootMarker then
        ShootMarker:Destroy()
        ShootMarker = nil
    end
end

local function UpdateShootMarker()

    if not ShowShootMarker then
        RemoveShootMarker()
        return
    end

    local Murderer = FindMurderer()

    if not Murderer or not Murderer.Character then
        RemoveShootMarker()
        return
    end

    local Target =
        Murderer.Character:FindFirstChild("Head")
        or Murderer.Character:FindFirstChild("HumanoidRootPart")

    if not Target then
        RemoveShootMarker()
        return
    end

    if not ShootMarker then

        ShootMarker = Instance.new("Part")
        ShootMarker.Name = "KRYVEX_ShootPosition"
        ShootMarker.Shape = Enum.PartType.Ball
        ShootMarker.Size = Vector3.new(0.7, 0.7, 0.7)
        ShootMarker.Material = Enum.Material.Neon
        ShootMarker.Color = Color3.fromRGB(255, 70, 70)
        ShootMarker.Transparency = 0.2

        ShootMarker.Anchored = true
        ShootMarker.CanCollide = false
        ShootMarker.CanTouch = false
        ShootMarker.CanQuery = false
        ShootMarker.CastShadow = false

        ShootMarker.Parent = workspace
    end

    local Position =
        Target.Position +
        (Target.CFrame.LookVector * ShootDistance)

    ShootMarker.Position = Position
end

task.spawn(function()
    while task.wait() do
        if ShowShootMarker then
            UpdateShootMarker()
        end
    end
end)

local function ShootMurderer()

    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return
    end

    local Gun =
        Character:FindFirstChild("Gun")

    if not Gun then

        local Backpack =
            LocalPlayer:FindFirstChild("Backpack")

        if Backpack then
            Gun = Backpack:FindFirstChild("Gun")
        end
    end

    if not Gun then

        Window:Notify({
            Title = "นายอำเภอ",
            Content = "ไม่พบ Gun",
            Duration = 3
        })

        return
    end

    if Gun.Parent ~= Character then
        Humanoid:EquipTool(Gun)
        task.wait(0.05)
    end

    Character = LocalPlayer.Character

    if not Character then
        return
    end

    Gun = Character:FindFirstChild("Gun")

    if not Gun then
        return
    end

    local Shoot = Gun:FindFirstChild("Shoot")

    if not Shoot then
        Shoot = getNil("Shoot", "RemoteEvent")
    end

    if not Shoot then

        Window:Notify({
            Title = "นายอำเภอ",
            Content = "ไม่พบ Shoot Remote",
            Duration = 3
        })

        return
    end

    local Murderer = FindMurderer()

    if not Murderer or not Murderer.Character then

        Window:Notify({
            Title = "นายอำเภอ",
            Content = "ไม่พบฆาตกร",
            Duration = 3
        })

        return
    end

    local Target =
        Murderer.Character:FindFirstChild("Head")
        or Murderer.Character:FindFirstChild("HumanoidRootPart")

    if not Target then
        return
    end

    local TargetPosition = Target.Position

    local SpawnPosition =
        TargetPosition +
        (Target.CFrame.LookVector * ShootDistance)

    local OriginCFrame =
        CFrame.new(
            SpawnPosition,
            TargetPosition
        )

    local TargetCFrame =
        CFrame.new(TargetPosition)

    Shoot:FireServer(
        OriginCFrame,
        TargetCFrame
    )

    Window:Notify({
        Title = "นายอำเภอ",
        Content =
            "ยิงฆาตกรแล้ว • ระยะ "
            .. string.format("%.1f", ShootDistance)
            .. " studs",
        Duration = 3
    })
end


