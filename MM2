local Steps = {
    {
        Text = "กำลังเริ่มต้นระบบ KOMAT...",
        Percent = 10
    },
    {
        Text = "กำลังโหลด KOMAT UI...",
        Percent = 30
    },
    {
        Text = "กำลังโหลดระบบ MM2...",
        Percent = 50
    },
    {
        Text = "กำลังเตรียมระบบฟาร์ม...",
        Percent = 70
    },
    {
        Text = "กำลังเตรียมระบบ ESP...",
        Percent = 85
    },
    {
        Text = "กำลังเปิดใช้งาน HUB...",
        Percent = 95
    },
    {
        Text = "SYSTEM ONLINE",
        Percent = 100
    }
}

local TotalTime = 5
local StepTime = TotalTime / #Steps

for _, Step in ipairs(Steps) do

    Status.Text = Step.Text

    if Step.Percent == 100 then
        Online.Text = "● SYSTEM ONLINE"
        Online.TextColor3 = Color3.fromRGB(70, 255, 180)
    else
        Online.Text = "● SYSTEM INITIALIZING"
        Online.TextColor3 = Color3.fromRGB(70, 130, 170)
    end

    TweenService:Create(
        Progress,
        TweenInfo.new(
            StepTime,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.new(
                Step.Percent / 100,
                0,
                1,
                0
            )
        }
    ):Play()

    local Current =
        tonumber(
            string.match(
                Percent.Text,
                "%d+"
            )
        ) or 0

    local Difference = Step.Percent - Current

    if Difference > 0 then
        for i = 1, Difference do
            Percent.Text =
                tostring(Current + i) .. "%"

            task.wait(
                StepTime / Difference
            )
        end
    end
end

