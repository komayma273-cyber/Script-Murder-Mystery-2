    Default = false,

    Callback = function(Value)

        TrapESPEnabled = Value

        if not Value then

            -- ลบ ESP ทั้งหมด
            for Object, Data in pairs(TrapESPObjects) do

                if Data.Highlight then
                    Data.Highlight:Destroy()
                end

                if Data.Billboard then
                    Data.Billboard:Destroy()
                end

                TrapESPObjects[Object] = nil

            end

            Window:Notify({
                Title = "มองหากับดัก",
                Content = "ปิดระบบแล้ว",
                Duration = 3
            })

            return
        end

        Window:Notify({
            Title = "มองหากับดัก",
            Content = "กำลังสแกนกับดัก",
            Duration = 3
        })

        task.spawn(function()

            while TrapESPEnabled do

                local CurrentTraps = {}

                --==================================================
                -- สแกน Workspace
                --==================================================

                for _, Object in ipairs(
                    workspace:GetDescendants()
                ) do

                    if not TrapESPEnabled then
                        break
