-- RenderStepped Loop สำหรับอัปเดตตำแหน่งวงกลมและล็อกเป้า
RunService.RenderStepped:Connect(function()
    -- อัปเดตขนาดและตำแหน่งของวงกลมให้อยู่กลางหน้าจอเสมอ
    local MousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Position = MousePos
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = AimLockEnabled

    if AimLockEnabled then
        local Murderer = FindMurderer()
        if Murderer and Murderer.Character then
            local TargetPart = Murderer.Character:FindFirstChild("Head") or Murderer.Character:FindFirstChild("HumanoidRootPart")
            
            if TargetPart then
                -- แปลงตำแหน่ง 3D ของฆาตกรเป็นตำแหน่ง 2D บนหน้าจอ
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
                
                if OnScreen then
                    local TargetVector = Vector2.new(ScreenPos.X, ScreenPos.Y)
                    local DistanceFromCenter = (TargetVector - MousePos).Magnitude

                    -- ตรวจสอบว่าฆาตกรอยู่ในเขตวงกลมหรือไม่
                    if DistanceFromCenter <= FOVRadius then
                        -- หันกล้องไปมองที่ตัวฆาตกร
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, TargetPart.Position)
                    end
                end
            end
        end
    end
end)

