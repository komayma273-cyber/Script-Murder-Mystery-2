local IsAuraActive = false

-- ฟังก์ชันดึงและล็อกผู้เล่นทุกคนไว้ตรงหน้า
local function ActivateKillAura()
    if IsAuraActive then return end

    local MyCharacter = LocalPlayer.Character
    if not MyCharacter then return end

    local MyHRP = MyCharacter:FindFirstChild("HumanoidRootPart")
    if not MyHRP then return end

    IsAuraActive = true

    if Window and Window.Notify then
        Window:Notify({
            Title = "ฆาตกร",
            Content = "ดึงผู้เล่นทั้งหมดมาไว้ตรงหน้า (2 วินาที)!",
            Duration = 2
        })
    end

    local StartTime = tick()
    local LoopConnection

    -- ใช้ RenderStepped เพื่อล็อกตำแหน่งผู้เล่นให้ติดอยู่ตรงหน้าเราตลอดช่วงเวลา
    LoopConnection = RunService.RenderStepped:Connect(function()
        -- ถ้าครบ 2 วินาทีแล้ว ให้หยุดล็อก
        if tick() - StartTime >= 2 then
            LoopConnection:Disconnect()
            IsAuraActive = false
            return
        end

        -- คำนวณตำแหน่งด้านหน้าเรา 3.5 บล็อก
        local FrontCFrame = MyHRP.CFrame * CFrame.new(0, 0, -3.5)

        for _, Player in ipairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer and Player.Character then
                local TargetHRP = Player.Character:FindFirstChild("HumanoidRootPart")
                local TargetHumanoid = Player.Character:FindFirstChildOfClass("Humanoid")

                -- ดึงเฉพาะผู้เล่นที่ยังไม่ตาย
                if TargetHRP and TargetHumanoid and TargetHumanoid.Health > 0 then
                    TargetHRP.CFrame = FrontCFrame
                end
            end
        end
    end)
end

