                        local Target = Object

                        -- ถ้าเป็น Model ใช้ตัว Model
                        -- ถ้าเป็น Part ก็ใช้ Part ได้
                        if Target:IsA("Model")
                        or Target:IsA("BasePart") then

                            CurrentTraps[Target] = true

                            --==================================================
