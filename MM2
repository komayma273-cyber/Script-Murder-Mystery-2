local SelectedPlayer = nil

local function GetCharacterRoot(Player)
    if not Player then
        return nil
    end

    local Character = Player.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function TeleportToPlayer(Player)
    local LocalCharacter = LocalPlayer.Character
    local TargetRoot = GetCharacterRoot(Player)

    if LocalCharacter and TargetRoot then
        local LocalRoot = LocalCharacter:FindFirstChild("HumanoidRootPart")

        if LocalRoot then
            LocalRoot.CFrame = TargetRoot.CFrame * CFrame.new(0, 0, 3)
        end
    end
end

local function FindPlayerWithTool(ToolName)
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local Character = Player.Character
            local Backpack = Player:FindFirstChild("Backpack")

            if Character and Character:FindFirstChild(ToolName) then
                return Player
            end

            if Backpack and Backpack:FindFirstChild(ToolName) then
                return Player
            end
        end
    end

    return nil
end

local function FindGunDrop()
    for _, Object in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(Object.Name), "gundrop", 1, true) then
            if Object:IsA("BasePart") then
                return Object
            end

            if Object:IsA("Model") then
                local Part = Object.PrimaryPart

                if not Part then
                    Part = Object:FindFirstChildWhichIsA("BasePart", true)
                end

                if Part then
                    return Part
                end
            end
        end
    end

    return nil
end

