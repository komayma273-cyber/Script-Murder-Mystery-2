-- ==========================================
-- KRYVEX HUB - PLAYER ROLE ESP
-- ==========================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local InnocentESP = false
local SheriffESP = false
local MurdererESP = false

local ESPObjects = {}

-- หา Role ของผู้เล่น
local function GetRole(Player)
    local Character = Player.Character

    if Character then
        local Role = Character:FindFirstChild("Role")
        if Role and Role:IsA("StringValue") then
            return Role.Value
        end
    end

    local Backpack = Player:FindFirstChild("Backpack")
    if Backpack then
        if Backpack:FindFirstChild("Knife") then
            return "Murderer"
        end

        if Backpack:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    if Character then
        if Character:FindFirstChild("Knife") then
            return "Murderer"
        end

        if Character:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    return "Innocent"
end

-- ลบ ESP ของผู้เล่น
local function RemoveESP(Player)
    local ESP = ESPObjects[Player]

    if ESP then
        ESP:Destroy()
        ESPObjects[Player] = nil
    end
end

-- สร้าง ESP
local function CreateESP(Player)
    if Player == LocalPlayer then
        return
    end

    local Character = Player.Character

    if not Character then
        return
    end

    local Role = GetRole(Player)

    local Enabled = false

    if Role == "Murderer" and MurdererESP then
        Enabled = true
    elseif Role == "Sheriff" and SheriffESP then
        Enabled = true
    elseif Role == "Innocent" and InnocentESP then
        Enabled = true
    end

    if not Enabled then
        RemoveESP(Player)
        return
    end

    RemoveESP(Player)

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "KRYVEX_RoleESP"
    Highlight.Adornee = Character
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.FillTransparency = 0.5
    Highlight.OutlineTransparency = 0

    if Role == "Murderer" then
        Highlight.FillColor = Color3.fromRGB(255, 60, 60)
        Highlight.OutlineColor = Color3.fromRGB(255, 0, 0)

    elseif Role == "Sheriff" then
        Highlight.FillColor = Color3.fromRGB(60, 140, 255)
        Highlight.OutlineColor = Color3.fromRGB(0, 100, 255)

    else
        Highlight.FillColor = Color3.fromRGB(80, 255, 120)
        Highlight.OutlineColor = Color3.fromRGB(0, 255, 80)
    end

    Highlight.Parent = Character
    ESPObjects[Player] = Highlight
end

-- อัปเดตทั้งหมด
local function UpdateAllESP()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            CreateESP(Player)
        end
