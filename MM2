local TimerESPEnabled = false
local TimerConnection = nil
local TimerGui = nil
local TimerLabel = nil

local function FindTimerText()
    -- ค้นหาทั่ว Workspace
    for _, Object in ipairs(workspace:GetDescendants()) do
        if Object.Name == "Timer" then

            if Object:IsA("TextLabel")
            or Object:IsA("TextButton")
            or Object:IsA("TextBox") then

                return Object
            end
        end
    end

    -- ค้นหาทั่ว PlayerGui
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if PlayerGui then
        for _, Object in ipairs(PlayerGui:GetDescendants()) do
            if Object.Name == "Timer" then

                if Object:IsA("TextLabel")
                or Object:IsA("TextButton")
                or Object:IsA("TextBox") then

                    return Object
                end
            end
        end
    end

    -- ค้นหาทั่ว ReplicatedStorage เผื่อเกมเก็บ UI/ข้อมูลไว้ที่นี่
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    for _, Object in ipairs(ReplicatedStorage:GetDescendants()) do
        if Object.Name == "Timer" then

            if Object:IsA("TextLabel")
            or Object:IsA("TextButton")
            or Object:IsA("TextBox") then

                return Object
            end
        end
    end

    return nil
end


local function CreateTimerGui()

    if TimerGui then
        TimerGui:Destroy()
        TimerGui = nil
        TimerLabel = nil
    end

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    TimerGui = Instance.new("ScreenGui")
    TimerGui.Name = "KOMAT_TimerDisplay"
    TimerGui.ResetOnSpawn = false
    TimerGui.IgnoreGuiInset = true
    TimerGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    TimerGui.Parent = PlayerGui

    TimerLabel = Instance.new("TextLabel")
    TimerLabel.Name = "TimerDisplay"

    -- ตรงกลางด้านบน
    TimerLabel.AnchorPoint = Vector2.new(0.5, 0)
    TimerLabel.Position = UDim2.new(0.5, 0, 0.04, 0)
    TimerLabel.Size = UDim2.new(0, 220, 0, 55)

    TimerLabel.BackgroundTransparency = 1

    TimerLabel.Text = "กำลังหา Timer..."
    TimerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TimerLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TimerLabel.TextStrokeTransparency = 0
    TimerLabel.TextScaled = true
    TimerLabel.Font = Enum.Font.GothamBold

    TimerLabel.ZIndex = 100
    TimerLabel.Parent = TimerGui
end


local function UpdateTimerText()

    if not TimerESPEnabled then
        return
    end

    if not TimerLabel then
        return
    end

    local Timer = FindTimerText()

    if Timer then
        TimerLabel.Text = Timer.Text
    else
        TimerLabel.Text = "ไม่พบ Timer"
    end
end


