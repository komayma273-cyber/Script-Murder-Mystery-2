local MurdererESP = false
local SheriffESP = false
local InnocentESP = false
local GunDropESP = false

local ESPObjects = {}
local GunDropObjects = {}

local function HasTool(Player, ToolName)
    local Character = Player.Character
    local Backpack = Player:FindFirstChild("Backpack")

    if Character and Character:FindFirstChild(ToolName) then
        return true
    end

    if Backpack and Backpack:FindFirstChild(ToolName) then
        return true
    end

    return false
end

local function IsInnocent(Player)
    return not HasTool(Player, "Knife") and not HasTool(Player, "Gun")
end

local function RemoveESP(Player)
    local Data = ESPObjects[Player]

    if Data then
        if Data.Highlight then
            Data.Highlight:Destroy()
        end

        if Data.Billboard then
            Data.Billboard:Destroy()
        end

        ESPObjects[Player] = nil
    end
end

local function CreateESP(Player, Role)
    if Player == LocalPlayer then
        return
    end

    local Character = Player.Character

    if not Character then
        return
    end

    local Head = Character:FindFirstChild("Head")

    if not Head then
        return
    end

    local Color
    local Text

    if Role == "Murderer" then
        if not MurdererESP then
            return
        end

        if not HasTool(Player, "Knife") then
            return
        end

        Color = Color3.fromRGB(255, 0, 0)
        Text = "ไอ่ชั่ว"

    elseif Role == "Sheriff" then
        if not SheriffESP then
            return
        end

        if not HasTool(Player, "Gun") then
            return
        end

        Color = Color3.fromRGB(0, 170, 255)
        Text = "นักปราบไอ่ชั่ว"

    elseif Role == "Innocent" then
        if not InnocentESP then
            return
        end

        if not IsInnocent(Player) then
            return
        end

        Color = Color3.fromRGB(0, 255, 0)
        Text = "คนดีย์"

    else
        return
    end

    local Old = ESPObjects[Player]

    if Old and Old.Role == Role and Old.Character == Character then
        return
    end

    RemoveESP(Player)

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "KOMAT_" .. Role .. "ESP"
    Highlight.Adornee = Character
    Highlight.FillColor = Color
    Highlight.OutlineColor = Color
    Highlight.FillTransparency = 0.35
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Character

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "KOMAT_" .. Role .. "Text"
    Billboard.Adornee = Head
    Billboard.Size = UDim2.fromOffset(180, 40)
    Billboard.StudsOffset = Vector3.new(0, 3, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = Head

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.fromScale(1, 1)
    TextLabel.BackgroundTransparency = 1
    TextLabel.Text = Text
    TextLabel.TextColor3 = Color
    TextLabel.TextStrokeTransparency = 0
    TextLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TextLabel.TextScaled = true
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.Parent = Billboard

    ESPObjects[Player] = {
        Highlight = Highlight,
        Billboard = Billboard,
        Role = Role,
        Character = Character
    }
end

local function UpdateESP()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local HasMurderer = MurdererESP and HasTool(Player, "Knife")
            local HasSheriff = SheriffESP and HasTool(Player, "Gun")
            local HasInnocent = InnocentESP and IsInnocent(Player)

            if HasMurderer then
                CreateESP(Player, "Murderer")
            elseif HasSheriff then
                CreateESP(Player, "Sheriff")
            elseif HasInnocent then
                CreateESP(Player, "Innocent")
            else
                RemoveESP(Player)
            end
        end
    end
end

local function RemoveGunDropESP(Object)
    local Data = GunDropObjects[Object]

    if Data then
        if Data.Highlight then
            Data.Highlight:Destroy()
        end

        if Data.Billboard then
            Data.Billboard:Destroy()
        end

        GunDropObjects[Object] = nil
    end
end

local function CreateGunDropESP(Object)
    if not GunDropESP then
        return
    end

    if not Object:IsA("Model") and not Object:IsA("BasePart") then
        return
    end

    local Color = Color3.fromRGB(255, 255, 0)
    local Adornee = Object
    local BillboardPart = Object

    if Object:IsA("Model") then
        local Primary = Object.PrimaryPart

        if not Primary then
            Primary = Object:FindFirstChildWhichIsA("BasePart", true)
        end

        if not Primary then
            return
        end

        BillboardPart = Primary
    end

    local Old = GunDropObjects[Object]

    if Old and Old.Adornee == Adornee then
        return
    end

    RemoveGunDropESP(Object)

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "KOMAT_GunDropESP"
    Highlight.Adornee = Adornee
    Highlight.FillColor = Color
    Highlight.OutlineColor = Color
    Highlight.FillTransparency = 0.35
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Object

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "KOMAT_GunDropText"
    Billboard.Adornee = BillboardPart
    Billboard.Size = UDim2.fromOffset(100, 40)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = BillboardPart

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.fromScale(1, 1)
    TextLabel.BackgroundTransparency = 1
    TextLabel.Text = "ปืน"
    TextLabel.TextColor3 = Color
    TextLabel.TextStrokeTransparency = 0
    TextLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TextLabel.TextScaled = true
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.Parent = Billboard

    GunDropObjects[Object] = {
        Highlight = Highlight,
        Billboard = Billboard,
        Adornee = Adornee
    }
end

local function UpdateGunDropESP()
    if not GunDropESP then
        for Object in pairs(GunDropObjects) do
            RemoveGunDropESP(Object)
        end
        return
    end

    local Found = {}

    for _, Object in ipairs(workspace:GetDescendants()) do
        local Name = string.lower(Object.Name)

        if string.find(Name, "gundrop", 1, true) then
            if Object:IsA("Model") or Object:IsA("BasePart") then
                Found[Object] = true
                CreateGunDropESP(Object)
            end
        end
    end

    for Object in pairs(GunDropObjects) do
        if not Found[Object] or not Object:IsDescendantOf(workspace) then
            RemoveGunDropESP(Object)
        end
    end
end

