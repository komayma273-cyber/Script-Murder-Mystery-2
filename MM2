local function ApplyMovementSettings(Character)

    local Humanoid =
        Character:WaitForChild("Humanoid", 10)

    if not Humanoid then
        return
    end

    Humanoid.WalkSpeed = SavedWalkSpeed
    Humanoid.JumpPower = SavedJumpPower
end

