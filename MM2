MurderTab:CreateSection("Hitbox")

local HitboxEnabled = false
local HitboxSize = 12
local HitboxCircle = nil
local HitboxConnection = nil
local LockedTarget = nil

local function RemoveHitboxCircle()
    if HitboxCircle then
        HitboxCircle:Destroy()
        HitboxCircle = nil
    end
end

local function CreateHitboxCircle()
    RemoveHitboxCircle()

    HitboxCircle = Instance.new("Part")
    HitboxCircle.Name = "KOMAT_HitboxCircle"
    HitboxCircle.Shape = Enum.PartType.Cylinder
    HitboxCircle.Size = Vector3.new(0.15, HitboxSize, HitboxSize)
    HitboxCircle.Color = Color3.fromRGB(255, 0, 0)
    HitboxCircle.Material = Enum.Material.Neon
    HitboxCircle.Transparency = 0.35
    HitboxCircle.Anchored = true
    HitboxCircle.CanCollide = false
    HitboxCircle.CanTouch = false
    HitboxCircle.CanQuery = false
    HitboxCircle.CastShadow = false
    HitboxCircle.Orientation = Vector3.new(0, 0, 90)
    HitboxCircle.Parent = workspace
end

local function UpdateHitboxCircle()
    if not HitboxCircle then
        return
    end

    local Character = LocalPlayer.Character
    if not Character then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then
        return
    end

    HitboxCircle.Size = Vector3.new(
        0.15,
        HitboxSize,
        HitboxSize
    )

    HitboxCircle.Position = Vector3.new(
        Root.Position.X,
        Root.Position.Y - 3,
        Root.Position.Z
    )
end

local function FindTargetInHitbox()
    local Character = LocalPlayer.Character
    if not Character then
        return nil
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then
        return nil
    end

    local ClosestTarget = nil
    local ClosestDistance = math.huge

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then

            local EnemyRoot =
                Player.Character:FindFirstChild("HumanoidRootPart")

            local Humanoid =
                Player.Character:FindFirstChildOfClass("Humanoid")

            if EnemyRoot and Humanoid and Humanoid.Health > 0 then

                local Offset = EnemyRoot.Position - Root.Position

                local Distance = Vector3.new(
                    Offset.X,
                    0,
                    Offset.Z
                ).Magnitude

                if Distance <= HitboxSize / 2 then

                    if Distance < ClosestDistance then
                        ClosestDistance = Distance
                        ClosestTarget = Player
                    end

                end
            end
        end
    end

    return ClosestTarget
end

local function LockTargetInFront(Target)
    if not Target then
        return
    end

    if not Target.Character then
        return
    end

    local Character = LocalPlayer.Character
    if not Character then
        return
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    local EnemyRoot =
        Target.Character:FindFirstChild("HumanoidRootPart")

    local EnemyHumanoid =
        Target.Character:FindFirstChildOfClass("Humanoid")

    if not Root or not EnemyRoot or not EnemyHumanoid then
        return
    end

    if EnemyHumanoid.Health <= 0 then
        return
    end

    EnemyRoot.CFrame =
        Root.CFrame *
        CFrame.new(0, 0, -4)
end

MurderTab:CreateToggle({
    Name = "ขยายฮิตบล็อก",
    Default = false,

    Callback = function(Value)

        HitboxEnabled = Value
        LockedTarget = nil

        if HitboxConnection then
            HitboxConnection:Disconnect()
            HitboxConnection = nil
        end

        RemoveHitboxCircle()

        if not Value then
            return
        end

        CreateHitboxCircle()

        HitboxConnection = RunService.RenderStepped:Connect(function()

            if not HitboxEnabled then
                return
            end

            local Character = LocalPlayer.Character
            if not Character then
                return
            end

            local Root =
                Character:FindFirstChild("HumanoidRootPart")

            if not Root then
                return
            end

            if not HitboxCircle or not HitboxCircle.Parent then
                CreateHitboxCircle()
            end

            UpdateHitboxCircle()

            if LockedTarget then

