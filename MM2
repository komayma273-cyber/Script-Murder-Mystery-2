local Camera = Workspace.CurrentCamera

local FlyEnabled = false
local FlySpeed = 1.5

local FlyVelocity = nil
local FlyGyro = nil
local FlyConnection = nil

local function StopFly()

    FlyEnabled = false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid.PlatformStand = false
        Humanoid.AutoRotate = true
    end
end

local function StartFly()

    StopFly()

    local Character = LocalPlayer.Character

    if not Character then
        return
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not RootPart then
        return
    end

    FlyEnabled = true

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.Name = "KOMAT_FlyVelocity"
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.P = 1000
    FlyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
    FlyVelocity.Parent = RootPart

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.Name = "KOMAT_FlyGyro"
    FlyGyro.P = 10000
    FlyGyro.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
    FlyGyro.CFrame = RootPart.CFrame
    FlyGyro.Parent = RootPart

    Humanoid.PlatformStand = true
    Humanoid.AutoRotate = false

    Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)

    FlyConnection = RunService.Heartbeat:Connect(function()

        if not FlyEnabled then
            return
        end

        if not RootPart.Parent or not Humanoid.Parent then
            StopFly()
            return
        end

        Camera = Workspace.CurrentCamera

        if not Camera then
            return
        end

        local MoveDirection = Humanoid.MoveDirection

        local HorizontalDirection = Vector3.new(
            MoveDirection.X,
            0,
            MoveDirection.Z
        )

        local VerticalDirection = 0

        if Camera.CFrame.LookVector.Y > 0.35 then
            VerticalDirection = Camera.CFrame.LookVector.Y
        elseif Camera.CFrame.LookVector.Y < -0.35 then
            VerticalDirection = Camera.CFrame.LookVector.Y
        end

        local Velocity = Vector3.zero

        if HorizontalDirection.Magnitude > 0 then
            Velocity = HorizontalDirection.Unit * FlySpeed * 50
        end

        Velocity = Velocity + Vector3.new(
            0,
            VerticalDirection * FlySpeed * 50,
            0
        )

        FlyVelocity.Velocity = Velocity

        FlyGyro.CFrame = Camera.CFrame
    end)
end

