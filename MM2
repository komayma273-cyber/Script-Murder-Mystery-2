local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ShootDistance = 1.5
local AutoShootEnabled = false

-- หาตัวผู้เล่นที่เป็นฆาตกร
local function FindMurderer()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local Character = Player.Character
            local Backpack = Player:FindFirstChild("Backpack")

            if (Character and Character:FindFirstChild("Knife")) or (Backpack and Backpack:FindFirstChild("Knife")) then
                return Player
            end
        end
    end
    return nil
end

-- ฟังก์ชันยิงฆาตกร
local function ShootMurderer()
    local Character = LocalPlayer.Character
    if not Character then return end

    -- เช็คว่าถือปืนอยู่ในมือหรือไม่
    local Gun = Character:FindFirstChild("Gun")
    if not Gun then return end

    -- หา RemoteEvent สำหรับยิง
    local Shoot = Gun:FindFirstChild("Shoot")
    if not Shoot and getnilinstances then
        for _, Object in ipairs(getnilinstances()) do
            if Object.ClassName == "RemoteEvent" and Object.Name == "Shoot" then
                Shoot = Object
                break
            end
        end
    end

    if not Shoot then return end

    -- หาตำแหน่งฆาตกร
    local Murderer = FindMurderer()
    if not Murderer or not Murderer.Character then return end

    local Target = Murderer.Character:FindFirstChild("Head") or Murderer.Character:FindFirstChild("HumanoidRootPart")
    if not Target then return end

    -- คำนวณทิศทางและส่งคำสั่งยิง
    local TargetPosition = Target.Position
    local SpawnPosition = TargetPosition + (Target.CFrame.LookVector * ShootDistance)
    local OriginCFrame = CFrame.new(SpawnPosition, TargetPosition)
    local TargetCFrame = CFrame.new(TargetPosition)

    Shoot:FireServer(OriginCFrame, TargetCFrame)
end

-- Loop ตรวจสอบการถือปืนแบบ Real-time
