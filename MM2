            Window:Notify({
                Title = "เตะ",
                Content = "ปิดระบบแล้ว",
                Duration = 3
            })

            return
        end

        TouchKickConnection =
            RunService.Heartbeat:Connect(
                function()

                    if not TouchKickEnabled then
                        return
                    end

                    local Character =
                        LocalPlayer.Character

                    if not Character then
                        return
                    end

                    local Root =
                        Character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if not Root then
                        return
                    end

                    for _, Player in ipairs(
                        Players:GetPlayers()
                    ) do

                        if Player ~= LocalPlayer
                        and Player.Character then

                            local TargetRoot =
                                Player.Character:
