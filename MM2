                -- เคลียร์เพื่อให้รอบใหม่ประกาศได้
                LastMurderer = nil
            end
        end


        -- นายอำเภอ
        if AnnounceSheriff then

            local Sheriff = GetPlayerWithTool("Gun")

            if Sheriff then

                if LastSheriff ~= Sheriff then
                    LastSheriff = Sheriff

                    SendChatMessage(
                        Sheriff.Name .. ":เป็นนายอำเภอ"
                    )
                end

            else
                -- ไม่มี Sheriff ในรอบปัจจุบัน
                LastSheriff = nil
            end
        end

    end

end)

