                                        task.spawn(
                                            function()

                                                FlingPlayer(
                                                    Player
                                                )

                                            end
                                        )

                                    end

                                end

                            end

                        end

                    end

                end
            )

        Window:Notify({
            Title = "เตะ",
            Content = "เปิดระบบแล้ว",
            Duration = 3
        })

    end
})


